# Express + Socket.IO listen address. Use 0.0.0.0 on a hosted server.
# PORT is only the local fallback: hosts like Railway and Render inject their own
# PORT at runtime and the app binds that instead, so the value here (or in
# shared/deployment.js) does not choose the production port. Railway typically
# injects 8080 - if a public domain has a target port set, it must match the port
# the app is actually listening on, or the edge proxy answers 502.
HOST=0.0.0.0
PORT=3000

# Development-only Vite proxy target. Leave as-is for `npm run dev`.
GAME_SERVER_URL=http://127.0.0.1:3000
VITE_PORT=5173

# Browser-facing game server URL, baked into the client at BUILD time because
# Vite inlines import.meta.env during `npm run build`. Set this whenever the
# client and the server live on different origins (the normal case for
# Vercel static hosting + a persistent Node host for Socket.IO):
#   vercel env add VITE_SOCKET_URL production
#   vercel env add VITE_SOCKET_URL preview
# The value is the public domain of the persistent Node host (Railway:
# Settings -> Networking -> Public Networking -> Generate Domain).
#
# When VITE_SOCKET_URL is NOT set, the client falls back to
# window.location.origin automatically — same-origin and reverse-proxy
# deployments (and localhost) connect with no configuration at all.
#
# A trailing slash, a ws:// or wss:// scheme, and http:// on an https:// page are
# all corrected by the client, as is a pasted .../socket.io endpoint. So paste
# the domain as the host shows it; only the host and optional base path matter.
# VITE_SOCKET_URL=https://fps-gods-production-1a2b.up.railway.app

# Persistent server-side lifetime-kill profiles. Mount durable storage on hosts
# with ephemeral local filesystems and point this variable to that mount.
# FPS_GODS_PROFILE_PATH=/var/data/fps-gods/profiles.json

# DEPRECATED: the Socket.IO handshake now answers
#   Access-Control-Allow-Origin: *
# for every origin, so deployment URLs can never drift out of sync with an
# allowlist and leave players on the CONNECTION LOST screen. CLIENT_ORIGIN is
# ignored by the server (it is only kept so old dashboards do not error).
# CLIENT_ORIGIN=
