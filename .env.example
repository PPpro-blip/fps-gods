# Express + Socket.IO listen address. Use 0.0.0.0 on a hosted server.
HOST=0.0.0.0
PORT=3001

# Development-only Vite proxy target. Leave as-is for `npm run dev`.
GAME_SERVER_URL=http://127.0.0.1:3001
VITE_PORT=5173

# Browser-facing game server URL, baked into the client at BUILD time because
# Vite inlines import.meta.env during `npm run build`. Required whenever the
# client and the server live on different origins, which is the normal case for
# Vercel (static client) + a persistent Node host (Socket.IO server).
# On Vercel set this as a project environment variable, then rebuild:
#   vercel env add VITE_SOCKET_URL production
#   vercel env add VITE_SOCKET_URL preview
# The value is the public domain of the persistent Node host (Railway:
# Settings -> Networking -> Public Networking -> Generate Domain).
# VITE_SOCKET_URL=https://fps-gods-production-1a2b.up.railway.app

# Comma-separated browser origins allowed by Socket.IO in production. Entries
# may contain `*` wildcards, which is how you allow hosts that mint a unique URL
# per deployment (Vercel previews) without listing every branch:
#   CLIENT_ORIGIN=https://fps-gods.vercel.app,https://fps-gods-*.vercel.app
# When empty, the server accepts every origin so localhost and preview
# deployments work with no configuration. This is a browser policy, not
# authentication: keep it restrictive in production.
# CLIENT_ORIGIN=https://fps-gods.vercel.app,https://fps-gods-*.vercel.app
