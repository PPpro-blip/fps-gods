# Express + Socket.IO listen address. Use 0.0.0.0 on a hosted server.
HOST=0.0.0.0
PORT=3001

# Development-only Vite proxy target. Leave as-is for `npm run dev`.
GAME_SERVER_URL=http://127.0.0.1:3001
VITE_PORT=5173

# Optional: set this when the browser client and game server are deployed on
# different origins, for example https://fps-gods-api.example.com
# VITE_SOCKET_URL=

# Optional comma-separated browser origins allowed by Socket.IO in production.
# When empty, the server accepts origins so localhost and preview deployments work.
# CLIENT_ORIGIN=https://fps-gods.example.com,https://www.fps-gods.example.com
