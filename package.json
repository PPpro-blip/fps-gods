{
  "name": "fps-gods",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based, server-authoritative multiplayer free-for-all FPS arena.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4"
  }
}
